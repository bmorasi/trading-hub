{% comment %}
  Shopify Section POC: Pokemon Buylist
  Upload assets:
  - buylist-styles.css
  - buylist-logo.avif
  - buylist-tcgdx-client.js
  - buylist-core-catalog-helpers.js
  - buylist-core-pricing.js
  - buylist-ui-basket.js
  - buylist-app.js
{% endcomment %}

{{ 'buylist-styles.css' | asset_url | stylesheet_tag }}

<div class="grain"></div>
<div class="buylist-shell" data-buylist-root data-vendor-email="{{ section.settings.vendor_email | escape }}" data-prices-url="{{ section.settings.prices_url | escape }}">
  <header class="hero">
    <img class="brand-logo" src="{{ 'buylist-logo.avif' | asset_url }}" alt="Card-Binder.com" />
    <p class="eyebrow">Card Binder Trade Desk</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="hero-copy">{{ section.settings.subheading }}</p>
    <ol id="how-steps" class="how-steps">
      <li>Choose a set</li>
      <li>Add your cards and pick each condition</li>
      <li>Open the basket and send your request</li>
    </ol>
  </header>

  <section class="panel search-panel">
    <h2 id="view-title" class="view-title">Choose a set</h2>
    <label id="search-label" for="card-search" class="label">Search sets</label>
    <div class="search-row">
      <input id="card-search" type="search" placeholder="Set name, for example Obsidian Flames" autocomplete="off" />
      <select id="set-filter" aria-label="Choose a set">
        <option value="">Choose a set</option>
      </select>
      <button id="clear-search" type="button" class="ghost hidden">Clear search</button>
      <button id="change-set" type="button" class="ghost hidden">Back to all sets</button>
    </div>
    <div id="set-grid" class="set-grid" aria-live="polite"></div>
    <p id="catalog-count" class="hint count"></p>
    <div id="card-sort-row" class="sort-row hidden">
      <label for="sort-field" class="sr-label">Sort by</label>
      <select id="sort-field">
        <option value="name:asc">Name (A to Z)</option>
        <option value="name:desc">Name (Z to A)</option>
        <option value="price:desc">Price (high to low)</option>
        <option value="price:asc">Price (low to high)</option>
        <option value="number:asc">Card number (low to high)</option>
        <option value="number:desc">Card number (high to low)</option>
        <option value="dex:asc">Pokedex number (low to high)</option>
        <option value="dex:desc">Pokedex number (high to low)</option>
      </select>
    </div>
    <div class="action-row">
      <span id="quick-offer" class="quick-offer hidden">Payout total: €0.00</span>
    </div>
    <div id="search-status" class="status" aria-live="polite"></div>
    <div id="loading-visual" class="loading-visual hidden" aria-live="polite" aria-busy="false">
      <div class="loading-head">
        <span class="loading-spinner" aria-hidden="true"></span>
        <strong id="loading-label">Loading catalog...</strong>
        <span id="loading-percent" class="loading-percent">0%</span>
      </div>
      <div class="loading-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="loading-bar" class="loading-bar"></div>
      </div>
      <div class="loading-skeleton-grid" aria-hidden="true">
        <div class="loading-skeleton-card"></div>
        <div class="loading-skeleton-card"></div>
        <div class="loading-skeleton-card"></div>
        <div class="loading-skeleton-card"></div>
        <div class="loading-skeleton-card"></div>
        <div class="loading-skeleton-card"></div>
      </div>
    </div>
    <div id="search-results" class="results-shell" aria-live="polite"></div>
    <div id="results-sentinel" class="results-sentinel" aria-hidden="true"></div>
  </section>
</div>

<div id="cart-overlay" class="cart-overlay hidden"></div>
<aside id="cart-drawer" class="cart-drawer hidden" role="dialog" aria-modal="true" aria-label="Purchase basket" aria-hidden="true">
  <section class="panel basket-panel">
    <div class="basket-head">
      <h2>Purchase Basket</h2>
      <div class="basket-head-actions">
        <button id="reset-basket" type="button" class="ghost">Reset</button>
        <button id="close-cart" type="button" class="ghost">Close</button>
      </div>
    </div>
    <p id="basket-empty" class="hint">Your basket is empty. Choose a set and add your cards.</p>
    <ul id="basket-items" class="basket-items"></ul>
    <div class="summary">
      <div><span>Condition-adjusted value</span><strong id="sum-value">€0.00</strong></div>
      <div><span id="sum-payout-label">Payout</span><strong id="sum-payout">€0.00</strong></div>
    </div>
    <div class="email-panel">
      <label for="seller-name">Customer Name</label>
      <input id="seller-name" type="text" placeholder="Full name" />
      <label for="seller-email">Customer Email</label>
      <input id="seller-email" type="email" placeholder="customer@example.com" />
      <label for="payout-method">Payment Option</label>
      <select id="payout-method">
        <option value="cash">Payout</option>
        <option value="credit">Store Credit</option>
      </select>
      <p id="photo-requirement-note" class="hint">Upload photos directly on each basket card worth €5 or more.</p>
      <label for="offer-spec">Notes (optional)</label>
      <textarea id="offer-spec" rows="4" placeholder="Condition notes, shipping details, etc."></textarea>
    </div>
    <div class="email-actions">
      <button id="send-offer-email" class="submit-btn" type="button">Send Purchase Request to CB</button>
      <button id="generate-pdf-report" class="ghost" type="button">Generate PDF Report</button>
    </div>
    <p id="attach-reminder" class="hint hidden"></p>
    <p id="vendor-email-note" class="hint"></p>
  </section>
</aside>

<button id="open-cart" type="button" class="floating-cart-btn" aria-label="Open basket">
  <span class="floating-cart-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M3 5h2l2.2 10.2A2 2 0 0 0 9.16 17h8.55a2 2 0 0 0 1.95-1.55L21 8H7.1"></path>
      <circle cx="10" cy="20" r="1.6"></circle>
      <circle cx="18" cy="20" r="1.6"></circle>
    </svg>
  </span>
  <span class="floating-cart-label">Basket (0)</span>
</button>

<template id="result-item-template">
  <li class="result-item">
    <div class="result-media">
      <img class="result-image" alt="" loading="lazy" />
      <div class="price-row">
        <span class="offer"></span>
      </div>
    </div>
    <div class="result-main">
      <h3 class="result-title"></h3>
      <p class="result-meta"></p>
    </div>
    <button class="add-btn" type="button">Add</button>
  </li>
</template>

<script type="module" src="{{ 'buylist-tcgdx-client.js' | asset_url }}"></script>
<script src="{{ 'buylist-core-catalog-helpers.js' | asset_url }}" defer></script>
<script src="{{ 'buylist-core-pricing.js' | asset_url }}" defer></script>
<script src="{{ 'buylist-ui-basket.js' | asset_url }}" defer></script>
<script src="{{ 'buylist-app.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pokemon Buylist POC",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pokemon Buylist"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Value is based on Cardmarket and payout is calculated by card condition."
    },
    {
      "type": "text",
      "id": "vendor_email",
      "label": "Vendor Email",
      "default": "vendor@example.com"
    },
    {
      "type": "text",
      "id": "prices_url",
      "label": "Cardmarket price file URL",
      "info": "Public address of cardmarket-prices.json. Leave empty to price from TCGdex only."
    }
  ],
  "presets": [
    {
      "name": "Pokemon Buylist POC"
    }
  ]
}
{% endschema %}
